// 日程調整ページ（chousei.html）用の Firestore セキュリティルール。
// Firebase コンソールの「Firestore Database → ルール」に貼り付けて「公開」する。
//
// - 日程調整（events）は、URL（推測できないID）を知っている人だけが読める。一覧は取れない。
// - 作った日程調整はあとから変更・削除できない。
// - 回答（answers）は、URLを知っている人なら追加・修正・削除できる（調整さんなどと同じ考え方）。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow get: if true;
      allow list: if false;
      allow create: if validEvent(request.resource.data);
      allow update, delete: if false;

      match /answers/{answerId} {
        allow read: if true;
        allow create, update: if validAnswer(request.resource.data);
        allow delete: if true;
      }
    }
  }

  function validEvent(d) {
    return d.keys().hasOnly(['title', 'dates', 'dayStart', 'dayEnd', 'minMinutes', 'createdAt'])
      && d.title is string && d.title.size() > 0 && d.title.size() <= 40
      && d.dates is list && d.dates.size() > 0 && d.dates.size() <= 60
      && d.dayStart is string && d.dayStart.matches('[0-2][0-9]:[0-5][0-9]')
      && d.dayEnd is string && d.dayEnd.matches('[0-2][0-9]:[0-5][0-9]')
      && d.minMinutes is int && d.minMinutes > 0 && d.minMinutes <= 1440
      && d.createdAt == request.time;
  }

  function validAnswer(d) {
    return d.keys().hasOnly(['name', 'at', 'slots', 'updatedAt'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 20
      && d.at is number
      && d.slots is map && d.slots.size() <= 60
      && d.updatedAt == request.time;
  }
}
